# Translation Agency — ignore rules

# Staging/cleanup folders left by the setup process (safe to delete)
_to_delete/
_claude/
_stage/

# Machine-local Claude Code settings (keep out of the repo)
.claude/settings.local.json

# Per-run translation markers and reports (untracked, per-machine)
.translate-last-review
.translate-report-*.json

# Per-project data written by /translate-init and /translate — LOCAL ONLY.
# Keeps private client project names, paths, notes, glossaries, and queries out of
# this (public) repo, and stops every init/translate run from showing as a diff.
# The toolkit ships only the template + README; the registry and per-project folders
# are recreated locally by the skills as you use them.
/projects/*/
!/projects/_template/
/projects/registry.json

# Generated translation output trees (uncomment if you don't want to commit outputs)
# translations/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Node (only if a target project's tooling leaks in)
node_modules/
dist/
